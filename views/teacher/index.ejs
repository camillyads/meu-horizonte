<%- include("../partials/header") %>

<div class="card">
  <h2>Painel do Professor</h2>
  <div class="grid">
    <div class="card">
      <h3>Turmas</h3>
      <p class="muted">Criar e listar turmas.</p>
      <a href="/professor/turmas">Abrir</a>
    </div>
    <div class="card">
      <h3>Alunos</h3>
      <p class="muted">Cadastrar aluno e gerar login/senha.</p>
      <a href="/professor/alunos">Abrir</a>
    </div>
    <div class="card">
      <h3>Atividades</h3>
      <p class="muted">Lançar tipo de atividade, especificação e dia.</p>
      <a href="/professor/atividades">Abrir</a>
    </div>
    <div class="card">
      <h3>Lançamentos (0/1)</h3>
      <p class="muted">Marcar cumprimento (1) ou não (0) por aluno.</p>
      <a href="/professor/lancamentos">Abrir</a>
    </div>
    <div class="card">
      <h3>Advertências e Observações</h3>
      <p class="muted">Registrar advertências e anotações.</p>
      <a href="/professor/advertencias">Abrir</a>
    </div>
    <div class="card">
      <h3>Documentos (PDF)</h3>
      <p class="muted">Publicar slides e arquivos para download.</p>
      <a href="/professor/documentos">Abrir</a>
    </div>
    <div class="card">
      <h3>Informações</h3>
      <p class="muted">Datas de prova, lembretes e eventos.</p>
      <a href="/professor/informacoes">Abrir</a>
    </div>
  </div>
</div>

<%- include("../partials/footer") %>
