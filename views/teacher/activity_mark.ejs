<%- include("../partials/header") %>

<div class="card">
  <div class="actions">
    <a class="tag" href="/professor">Voltar</a>
  </div>
  <h2>Lançamentos (0/1)</h2>

  <div class="grid">
    <div class="card">
      <h3>Selecionar turma e atividade</h3>
      <form method="get" action="/professor/lancamentos">
        <label>
          Turma
          <select name="classId" required>
            <option value="">Selecione...</option>
            <% for (const c of classes) { %>
              <option value="<%= c.id %>" <%= turma && turma.id === c.id ? "selected" : "" %>><%= c.code %></option>
            <% } %>
          </select>
        </label>
        <label>
          Atividade
          <select name="activityId" <%= activities.length ? "" : "disabled" %>>
            <option value="">Selecione...</option>
            <% for (const a of activities) { %>
              <option value="<%= a.id %>" <%= activity && activity.id === a.id ? "selected" : "" %>>
                <%= a.date %> - <%= a.title %>
              </option>
            <% } %>
          </select>
        </label>
        <button type="submit">Carregar</button>
      </form>
    </div>

    <div class="card">
      <h3>Planilha</h3>
      <% if (!turma) { %>
        <p class="muted">Selecione uma turma para ver as atividades e alunos.</p>
      <% } else if (!activity) { %>
        <p class="muted">Selecione uma atividade para lançar 0/1.</p>
      <% } else if (!students.length) { %>
        <p class="muted">Não há alunos cadastrados nessa turma.</p>
      <% } else { %>
        <p class="muted">Atividade: <span class="tag"><%= activity.date %></span> <%= activity.title %></p>
        <form method="post" action="/professor/lancamentos">
          <input type="hidden" name="activityId" value="<%= activity.id %>" />
          <table>
            <thead>
              <tr>
                <th>Aluno</th>
                <th class="nowrap">0/1</th>
              </tr>
            </thead>
            <tbody>
              <% for (const s of students) { %>
                <tr>
                  <td><%= s.fullName %></td>
                  <td class="nowrap">
                    <select name="done_<%= s.id %>">
                      <option value="0" <%= completionByStudentId.get(s.id) === 0 ? "selected" : "" %>>0</option>
                      <option value="1" <%= completionByStudentId.get(s.id) === 1 ? "selected" : "" %>>1</option>
                    </select>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
          <div style="height: 10px"></div>
          <button type="submit">Salvar lançamentos</button>
        </form>
      <% } %>
    </div>
  </div>
</div>

<%- include("../partials/footer") %>
