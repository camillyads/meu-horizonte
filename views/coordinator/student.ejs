<%- include("../partials/header") %>

<div class="card">
  <div class="actions">
    <a class="tag" href="/coordenacao/turma/<%= turma ? turma.id : "" %>">Voltar para a turma</a>
  </div>

  <h2><%= student.fullName %></h2>
  <p class="muted">Turma: <%= turma ? turma.code : "-" %> | Login: <span class="tag"><%= student.login %></span></p>

  <div class="grid">
    <div class="card">
      <h3>Aguardando análise (<%= pending.length %>)</h3>
      <% if (!pending.length) { %>
        <p class="muted">Nenhuma advertência pendente.</p>
      <% } else { %>
        <ul>
          <% for (const w of pending) { %>
            <li><span class="tag"><%= w.date %></span> <%= w.type %></li>
          <% } %>
        </ul>
        <form method="post" action="/coordenacao/aluno/<%= student.id %>/resolver">
          <button type="submit">Marcar pendentes como resolvidas</button>
        </form>
      <% } %>
    </div>

    <div class="card">
      <h3>Resolvidas (<%= resolved.length %>)</h3>
      <% if (!resolved.length) { %>
        <p class="muted">Nenhuma advertência resolvida.</p>
      <% } else { %>
        <ul>
          <% for (const w of resolved) { %>
            <li><span class="tag"><%= w.date %></span> <%= w.type %></li>
          <% } %>
        </ul>
      <% } %>
    </div>

    <div class="card">
      <h3>Observações do professor</h3>
      <% if (!observations.length) { %>
        <p class="muted">Nenhuma observação registrada.</p>
      <% } else { %>
        <ul>
          <% for (const o of observations) { %>
            <li>
              <span class="tag"><%= o.date %></span>
              <span class="muted"><%= o.text %></span>
            </li>
          <% } %>
        </ul>
      <% } %>
    </div>
  </div>
</div>

<%- include("../partials/footer") %>
